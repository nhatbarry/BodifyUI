<manifest xmlns:android="http://schemas.android.com/apk/res/android">
   <uses-permission android:name="android.permission.INTERNET"/>
   <!-- The AI coach watches the user perform a set. Nothing is recorded or
        uploaded: frames go to on-device ML Kit and are discarded. -->
   <uses-permission android:name="android.permission.CAMERA"/>
   <!-- A phone without a camera can still use every other screen, so the
        camera is optional rather than a requirement to install. -->
   <uses-feature android:name="android.hardware.camera" android:required="false"/>
   <!-- Phase 8: read-only access to Health Connect. Steps, distance and heart
        rate are what the home screen shows; nothing is written back. -->
   <uses-permission android:name="android.permission.health.READ_STEPS"/>
   <uses-permission android:name="android.permission.health.READ_DISTANCE"/>
   <uses-permission android:name="android.permission.health.READ_HEART_RATE"/>
   <!-- Lets the app see whether Health Connect is installed (Android 13 and
        below ship it as a separate app). -->
   <queries>
       <package android:name="com.google.android.apps.healthdata" />
       <intent>
           <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
       </intent>
   </queries>
   <application
        android:label="Bodify"
        android:name="${applicationName}"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Health Connect links to the app's privacy rationale from its
             permission screen, and on Android 14+ refuses to list an app
             that does not declare one. It opens the main activity. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
        <!-- Android 13 and below: the same rationale, asked by the
             standalone Health Connect app. -->
        <activity-alias
            android:name="ShowPermissionRationaleActivity"
            android:exported="true"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity-alias>
        <!-- Where Supabase sends the browser back to after a Facebook
             sign-in. The scheme must match OAUTH_REDIRECT_URL on the backend
             and the redirect allowlist in the Supabase dashboard; the
             activity itself comes from the flutter_web_auth_2 plugin, which
             hands the callback URL back to Dart. -->
        <activity
            android:name="com.linusu.flutter_web_auth_2.CallbackActivity"
            android:exported="true">
            <intent-filter android:label="flutter_web_auth_2">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="bodify" />
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
</manifest>
